# Mobile App Environment Variables
# Copy this file to .env and fill in your values

# REST API (gateway service)
EXPO_PUBLIC_API_URL=https://YOUR-NGROK-URL.ngrok-free.app/api

# Socket Service — if different ngrok URL than API (recommended for separate socket service)
# Leave blank to auto-derive from EXPO_PUBLIC_API_URL by swapping port to 5002
EXPO_PUBLIC_SOCKET_URL=https://YOUR-SOCKET-NGROK-URL.ngrok-free.app
